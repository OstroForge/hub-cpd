# Copy this file to .env and fill it in. .env is gitignored.
# DEBUG=true uses the DEV workbooks. DEBUG=false uses the LIVE workbooks.
# This laptop is DEBUG=true. The live Hub is DEBUG=false.
# Restart python serve.py after you edit it.
#
# Passcode for a session that is not on the live home page yet.
# Set this on the live Hub only (Render → hub-cpd → Environment → DRAFT_CODE).
# This laptop is DEBUG=true, so its home page lists every session and does not ask for it.
DRAFT_CODE=

DEBUG=true

# Same text as Render's PRESENTERS variable. Copy the value inside the quotes into the dashboard.
PRESENTERS="ABCD: Jane Smith; EFGH: Alex Jones"

# Feedback workbooks. This laptop uses the DEV line. The hosted Hub uses the LIVE line.
# Each name below is a prompt. DEV stays on this laptop. LIVE is also created on the live Render service.
# Create FEEDBACK_SHARE_COPD_DEV in this laptop's .env.
# Create FEEDBACK_SHARE_COPD_LIVE on the live Render service.
FEEDBACK_SHARE_COPD_DEV=
FEEDBACK_SHARE_COPD_LIVE=
# Create FEEDBACK_SHARE_HF_DEV in this laptop's .env.
# Create FEEDBACK_SHARE_HF_LIVE on the live Render service.
FEEDBACK_SHARE_HF_DEV=
FEEDBACK_SHARE_HF_LIVE=
# Create FEEDBACK_SHARE_ASTHMA_DEV in this laptop's .env.
# Create FEEDBACK_SHARE_ASTHMA_LIVE on the live Render service.
FEEDBACK_SHARE_ASTHMA_DEV=
FEEDBACK_SHARE_ASTHMA_LIVE=
# Create FEEDBACK_SHARE_STROKE_DEV in this laptop's .env.
# Create FEEDBACK_SHARE_STROKE_LIVE on the live Render service.
FEEDBACK_SHARE_STROKE_DEV=
FEEDBACK_SHARE_STROKE_LIVE=
