# Copy this file to .env and fill it in. .env is gitignored.
# DEBUG=true uses the DEV workbooks. DEBUG=false uses the LIVE workbooks.
# This laptop is DEBUG=true. The live Hub is DEBUG=false. The test Hub is DEBUG=true.
# Restart python serve.py after you edit it.

DEBUG=true

# Same text as Render's PRESENTERS variable. Copy the value inside the quotes into the dashboard.
PRESENTERS="ABCD: Jane Smith; EFGH: Alex Jones"

# Feedback workbooks. This laptop uses the DEV line. The hosted Hub uses the LIVE line.
# Add a DEV and a LIVE line when a topic gets a sheet.
FEEDBACK_SHARE_COPD_DEV=
FEEDBACK_SHARE_COPD_LIVE=
FEEDBACK_SHARE_HF_DEV=
FEEDBACK_SHARE_HF_LIVE=
FEEDBACK_SHARE_ASTHMA_DEV=
FEEDBACK_SHARE_ASTHMA_LIVE=
